DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
ADMIN_CHANNEL_ID=
REQUESTS_CHANNEL_ID=
SEERR_URL=
SEERR_API_KEY=
WEBHOOK_SECRET=
WEBHOOK_PORT=
ADMIN_ROLE_ID=

# Public links for /link. Leave blank to hide.
JELLYFIN_PUBLIC_URL=
PLEX_PUBLIC_URL=
SEERR_PUBLIC_URL=
STATUS_PAGE_URL=
# Extra links: Name|https://example.com,Other|https://example.org
LINKS_EXTRA=

# Uptime Kuma public status page. Both are required for /status.
UPTIME_KUMA_URL=
UPTIME_KUMA_STATUS_SLUG=
# Channel for down / back up alerts. Blank skips the Kuma webhook.
STATUS_CHANNEL_ID=
# Channel for /announce and the Sunday "New this week" post. Blank posts /announce in the current channel and skips the weekly post.
ANNOUNCE_CHANNEL_ID=

# Jellyfin. Dashboard → API Keys. URL has no trailing path.
JELLYFIN_URL=
JELLYFIN_API_KEY=

# Sonarr. Settings → General → API Key.
SONARR_URL=
SONARR_API_KEY=

# Tautulli. Settings → Web Interface → API key. Plex only.
TAUTULLI_URL=
TAUTULLI_API_KEY=

# Beszel. The admin email and password you use to sign in. URL is the Beszel hub.
BESZEL_URL=
BESZEL_EMAIL=
BESZEL_PASSWORD=

# Arcane. System → API Keys. Environment id 0 is the local Docker engine.
ARCANE_URL=
ARCANE_API_KEY=
ARCANE_ENV_ID=
# Comma-separated container names /restart is allowed to touch.
RESTART_ALLOWLIST=

# Weekly post and inactivity check. Default is Sunday 20:00 Asia/Dubai: 0 20 * * 0
NEW_THIS_WEEK_CRON=
INACTIVE_DAYS=
# Decline DMs are only sent for requests made within this many days. Default 14. Older ones are Seerr cleanup.
DECLINE_DM_MAX_AGE_DAYS=

# MausBot chat through n8n. Leave the URL blank to disable. Bot ids and bak_ keys stay in n8n.
N8N_BOTS_WEBHOOK_URL=
N8N_BOTS_SECRET=
# hestia:channelId,iris:channelId
BOT_CHANNELS=
